# Copy to .env. Keep this file and backups private. Use URL-safe random passwords.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
PORTAL_ORIGIN=https://propiedades.example.com
KEYCLOAK_ORIGIN=https://auth.example.com
KEYCLOAK_REALM=propiedades
KEYCLOAK_AUDIENCE=propiedades-api
KEYCLOAK_ALLOWED_SUBJECT=
KEYCLOAK_LOGIN_CLIENT_ID=portal-login
KEYCLOAK_LOGIN_CLIENT_SECRET=
# Absolute Windows path shared with Docker Desktop, e.g. C:/ProgramData/Aelium/PropiedadesDocker/backups
BACKUP_DIR=
# Optional host ports; choose ports not reserved by Windows.
KEYCLOAK_PORT=58082
API_PORT=58090
API_IMAGE=ghcr.io/cleonsanchezgp-glitch/gestion-de-propiedades:stable
