# Copy to .env. Use independent, random passwords without URL-reserved characters.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Public HTTPS origins, without trailing slash. No localhost for production.
PORTAL_ORIGIN=https://propiedades.example.com
KEYCLOAK_ORIGIN=https://auth.example.com
KEYCLOAK_REALM=propiedades
KEYCLOAK_AUDIENCE=propiedades-api
KEYCLOAK_ALLOWED_SUBJECT=
KEYCLOAK_LOGIN_CLIENT_ID=portal-login
KEYCLOAK_LOGIN_CLIENT_SECRET=
