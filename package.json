{
  "name": "aelium-propiedades-test-infrastructure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:prepare": "node tests/scripts/prepare.mjs",
    "test:infra:up": "node tests/scripts/infra.mjs up",
    "test:infra:down": "node tests/scripts/infra.mjs down",
    "test:infra:check": "node tests/scripts/check-infra.mjs",
    "test:api": "node tests/scripts/check-api.mjs",
    "backend:test": "cargo test --manifest-path backend/Cargo.toml",
    "backend:build": "cargo build --manifest-path backend/Cargo.toml",
    "backend:dev": "node tests/scripts/run-backend.mjs",
    "backend:local": "node tests/scripts/run-backend.mjs --owner",
    "local:prepare": "node tests/scripts/provision-local-user.mjs",
    "local:login-config": "node tests/scripts/configure-portal-login.mjs",
    "frontend:dev": "npm --prefix frontend run dev",
    "docker:dev:up": "node deploy/dev/manage.mjs up",
    "docker:dev:down": "node deploy/dev/manage.mjs down",
    "docker:dev:status": "node deploy/dev/manage.mjs status",
    "frontend:build": "npm --prefix frontend run build",
    "test:browser": "npm --prefix frontend run test:browser",
    "test:windows-installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/scripts/check-windows-installer.ps1",
    "backend:package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Build-Package.ps1",
    "backend:package:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Build-FreshBackendInstaller.ps1"
  }
}
